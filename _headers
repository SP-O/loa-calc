# pages.dev 는 loadoss.com 과 바이트까지 같은 복제본이라 색인되면 안 된다.
# canonical 만으로는 부족하다 — 구글이 무시한 전례가 있다(/tools/auction).
# 컷오버 후에도 남겨 둔다. loadoss.com 요청은 이 규칙에 걸리지 않는다.
https://loa-calc-6ny.pages.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/vendor/*
  Cache-Control: public, max-age=2592000

/object/*
  Cache-Control: public, max-age=2592000

/tools/tikatuka/guide-share.png
  Cache-Control: public, max-age=2592000

# 아래 넷은 HTML에서 ?v=날짜 를 달고 부른다. 파일이 바뀌면 그 값을 올려 URL이 달라지므로
# 길게 잡아도 낡은 파일이 남지 않는다. ★버전을 올리지 않으면 이 기간만큼 낡은 채로 나간다.
# tools/* 스크립트에는 ?v= 가 없다(모듈이 상대경로로 서로를 부른다) — 그래서 5분을 유지한다.
/assets/content.css
  Cache-Control: public, max-age=604800

/assets/content.js
  Cache-Control: public, max-age=604800

/assets/easter-egg.css
  Cache-Control: public, max-age=604800

/assets/easter-egg.js
  Cache-Control: public, max-age=604800

/tools/auction/*
  Cache-Control: public, max-age=300

/tools/tikatuka/app.js
  Cache-Control: public, max-age=300

/tools/tikatuka/styles.css
  Cache-Control: public, max-age=300

/tools/tikatuka/src/*
  Cache-Control: public, max-age=300
