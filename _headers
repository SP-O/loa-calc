# pages.dev 는 loadoss.com 과 바이트까지 같은 복제본이라 색인되면 안 된다.
# canonical 만으로는 부족하다 — 구글이 무시한 전례가 있다(/tools/auction).
# 컷오버 후에도 남겨 둔다. loadoss.com 요청은 이 규칙에 걸리지 않는다.
https://loa-calc-6ny.pages.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/vendor/*
  Cache-Control: public, max-age=2592000

/object/*
  Cache-Control: public, max-age=2592000

/tools/tikatuka/guide-share.png
  Cache-Control: public, max-age=2592000

/assets/content.css
  Cache-Control: public, max-age=300

/assets/content.js
  Cache-Control: public, max-age=300

/assets/easter-egg.css
  Cache-Control: public, max-age=300

/assets/easter-egg.js
  Cache-Control: public, max-age=300

/tools/auction/*
  Cache-Control: public, max-age=300

/tools/tikatuka/app.js
  Cache-Control: public, max-age=300

/tools/tikatuka/styles.css
  Cache-Control: public, max-age=300

/tools/tikatuka/src/*
  Cache-Control: public, max-age=300
